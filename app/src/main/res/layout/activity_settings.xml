<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sms_screen_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/sms_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/settingsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:src="@drawable/ic_arrow_back_24"
            android:tint="@color/sms_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paramètre"
            android:textColor="@color/sms_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sms_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vérification de l’opérateur"
                android:textColor="@color/sms_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cette vérification identifie uniquement la SIM ; elle ne confirme pas l’activation d’un compte MVola."
                android:textColor="@color/sms_text_secondary"
                android:textSize="14sp" />

            <AutoCompleteTextView
                android:id="@+id/expectedOperator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Opérateur attendu"
                android:inputType="textCapWords"
                android:minHeight="56dp"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/acceptedOperatorNames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Autres noms acceptés (séparés par des virgules)"
                android:inputType="textCapWords"
                android:minHeight="56dp"
                android:paddingHorizontal="12dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveOperatorConfiguration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enregistrer" />

            <TextView
                android:id="@+id/operatorVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Opérateur non configuré"
                android:textColor="@color/sms_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/requestPhonePermission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Autoriser la vérification des SIM"
                android:visibility="gone" />

            <TextView
                android:id="@+id/exportDiagnosticReport"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="Exporter le rapport diagnostic"
                android:textColor="@color/sms_text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
