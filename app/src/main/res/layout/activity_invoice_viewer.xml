<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#172F46" android:orientation="vertical">
    <LinearLayout android:id="@+id/invoiceViewerHeader"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <ImageButton android:id="@+id/invoiceViewerBack" android:layout_width="48dp"
            android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour" android:src="@drawable/ic_arrow_back_24"
            android:tint="@android:color/white" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Facture enregistrée" android:textColor="@android:color/white"
            android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/invoiceViewerImage" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:adjustViewBounds="true"
        android:contentDescription="Image de la facture" android:scaleType="fitCenter" />
</LinearLayout>
