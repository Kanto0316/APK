<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/sms_surface" android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="4dp"
        android:paddingTop="7dp" android:paddingEnd="4dp" android:paddingBottom="7dp">

        <TextView android:id="@+id/itemNumber" android:layout_width="@dimen/sms_column_number_width"
            android:layout_height="wrap_content" android:gravity="center"
            android:maxLines="1" android:textColor="@color/sms_text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/itemDateTime" android:layout_width="@dimen/sms_column_datetime_width"
            android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:textColor="@color/sms_text_secondary" android:textSize="12sp" />
        <FrameLayout android:layout_width="@dimen/sms_column_type_width"
            android:layout_height="wrap_content" android:foregroundGravity="center">
            <TextView android:id="@+id/itemType" android:layout_width="wrap_content"
                android:layout_height="22dp" android:layout_gravity="center" android:gravity="center"
                android:includeFontPadding="false" android:maxLines="1"
                android:paddingStart="7dp" android:paddingEnd="7dp"
                android:textColor="@color/sms_text_secondary" android:textSize="12sp" />
        </FrameLayout>
        <TextView android:id="@+id/itemSender" android:layout_width="@dimen/sms_column_sender_width"
            android:layout_height="wrap_content" android:ellipsize="end" android:gravity="start|center_vertical"
            android:maxLines="1" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:textColor="@color/sms_text_primary" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/itemName" android:layout_width="@dimen/sms_column_name_width"
            android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center"
            android:maxLines="1" android:textColor="@color/sms_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/itemAmount" android:layout_width="@dimen/sms_column_money_width"
            android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:textColor="@color/sms_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/itemReference" android:layout_width="@dimen/sms_column_reference_width"
            android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center"
            android:maxLines="1" android:textColor="@color/sms_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/itemBonus" android:layout_width="@dimen/sms_column_money_width"
            android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:textColor="@color/sms_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/itemFees" android:layout_width="@dimen/sms_column_money_width"
            android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:textColor="@color/sms_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/itemBalance" android:layout_width="@dimen/sms_column_money_width"
            android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
            android:textColor="@color/sms_text_primary" android:textSize="13sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/sms_divider" />
</LinearLayout>
