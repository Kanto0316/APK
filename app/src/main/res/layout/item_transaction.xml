<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sms_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/itemNumber"
            android:layout_width="@dimen/sms_column_number_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/sms_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/itemSender"
            android:layout_width="@dimen/sms_column_sender_width"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:textColor="@color/sms_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemBody"
            android:layout_width="@dimen/sms_column_message_width"
            android:layout_height="wrap_content"
            android:breakStrategy="high_quality"
            android:gravity="start|center_vertical"
            android:hyphenationFrequency="normal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/sms_text_body"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/itemDate"
            android:layout_width="@dimen/sms_column_date_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/sms_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/itemTime"
            android:layout_width="@dimen/sms_column_time_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/sms_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sms_divider" />
</LinearLayout>
