<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sms_screen_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sms_surface"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suivi SMS"
            android:textColor="@color/sms_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Vos messages, du plus récent au plus ancien"
            android:textColor="@color/sms_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/capturedCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nombre de SMS capturés par Suivi SMS : 0"
            android:textColor="@color/sms_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/smsDiagnosticsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:contentDescription="Diagnostic temporaire de réception SMS">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostic réception SMS"
                android:textColor="@color/sms_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lastSmsBroadcastText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dernier SMS capturé en arrière-plan : jamais"
                android:textColor="@color/sms_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lastRoomInsertionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dernière insertion Room : jamais"
                android:textColor="@color/sms_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lastBackupText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Dernière sauvegarde : aucune"
            android:textColor="@color/sms_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backupButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sauvegarder maintenant" />

            <Button
                android:id="@+id/restoreButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restaurer sauvegarde" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/permissionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_permission_notice"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"
        android:text="Capture SMS inactive : l’autorisation de réception des SMS n’est pas accordée. Appuyez ici pour la demander."
        android:textColor="@color/sms_permission_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/backgroundExecutionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_permission_notice"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="Exécution en arrière-plan limitée. Appuyez ici pour autoriser le démarrage automatique et la capture lorsque l’application est fermée."
        android:textColor="@color/sms_permission_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:text="Aucun message enregistré"
        android:textColor="@color/sms_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:contentDescription="Chargement des messages"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

</LinearLayout>
