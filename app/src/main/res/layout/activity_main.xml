<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sms_screen_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sms_surface"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Suivi SMS"
                android:textColor="@color/sms_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/overflowButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Plus d’options"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert_24"
                android:tint="@color/sms_text_primary" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sms_divider" />

    <TextView
        android:id="@+id/permissionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_permission_notice"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true"
        android:text="Capture SMS inactive : l’autorisation de réception des SMS n’est pas accordée. Appuyez ici pour la demander."
        android:textColor="@color/sms_permission_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/backgroundExecutionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_permission_notice"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="Exécution en arrière-plan limitée. Appuyez ici pour autoriser le démarrage automatique et la capture lorsque l’application est fermée."
        android:textColor="@color/sms_permission_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="@dimen/sms_table_width"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/smsTableHeader"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/sms_table_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="@dimen/sms_column_number_width"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="#"
                    android:textColor="@color/sms_table_header_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="@dimen/sms_column_sender_width"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Numéro"
                    android:textColor="@color/sms_table_header_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="@dimen/sms_column_message_width"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Message"
                    android:textColor="@color/sms_table_header_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="@dimen/sms_column_date_width"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Date"
                    android:textColor="@color/sms_table_header_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="@dimen/sms_column_time_width"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Heure"
                    android:textColor="@color/sms_table_header_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:text="Aucun message enregistré"
                android:textColor="@color/sms_text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loadingIndicator"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:contentDescription="Chargement des messages"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transactionsList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- This container participates in the vertical layout, so it can never cover a list row. -->
    <FrameLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.example.testapp.NotchedBottomBarView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/bottomMessages"
                style="@style/SmsBottomNavigationItem.Active"
                android:drawableTop="@drawable/ic_sms_24"
                android:text="Messages" />

            <TextView
                android:id="@+id/bottomImport"
                style="@style/SmsBottomNavigationItem"
                android:drawableTop="@drawable/ic_file_download_24"
                android:text="Importer" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1.2" />

            <TextView
                android:id="@+id/bottomExport"
                style="@style/SmsBottomNavigationItem"
                android:drawableTop="@drawable/ic_file_upload_24"
                android:text="Exporter" />

            <TextView
                android:id="@+id/bottomMenu"
                style="@style/SmsBottomNavigationItem"
                android:drawableTop="@drawable/ic_more_horiz_24"
                android:text="Menu" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_refresh_button"
            android:contentDescription="Actualiser la liste des SMS"
            android:elevation="10dp"
            android:padding="20dp"
            android:src="@drawable/ic_refresh_24"
            android:tint="@color/white" />

        <TextView
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center"
            android:paddingBottom="7dp"
            android:text="Actualiser"
            android:textColor="@color/sms_bottom_item"
            android:textSize="10sp" />
    </FrameLayout>

</LinearLayout>
