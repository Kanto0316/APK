<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sms_screen_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sms_surface"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/balanceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Solde : 0 Ar &gt;"
                android:textColor="@color/sms_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/overflowButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Plus d’options"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert_24"
                android:tint="@color/sms_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sms_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/messagesSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <EditText
                android:id="@+id/messageSearchInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_client_search"
                android:drawableStart="@drawable/ic_search_24"
                android:drawablePadding="10dp"
                android:hint="Rechercher un numéro ou un nom"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/sms_text_primary"
                android:textColorHint="@color/sms_text_secondary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:id="@+id/filterScrollView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/sms_surface"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <TextView android:id="@+id/filterAll" style="@style/SmsFilterChip" android:text="Tous" />
                    <TextView android:id="@+id/filterToday" style="@style/SmsFilterChip" android:text="Aujourd'hui" />
                    <TextView android:id="@+id/filterYesterday" style="@style/SmsFilterChip" android:text="Hier" />
                    <TextView android:id="@+id/filterSevenDays" style="@style/SmsFilterChip" android:text="7 jours" />
                    <TextView android:id="@+id/filterThirtyDays" style="@style/SmsFilterChip" android:text="30 jours" />
                    <TextView android:id="@+id/filterDate" style="@style/SmsFilterChip" android:text="Date" />
                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/typeFilterScrollView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/sms_surface"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <TextView android:id="@+id/typeFilterAll" style="@style/SmsFilterChip" android:text="Tous" />
                    <TextView android:id="@+id/typeFilterDeposit" style="@style/SmsFilterChip" android:text="Dépôt" />
                    <TextView android:id="@+id/typeFilterWithdrawal" style="@style/SmsFilterChip" android:text="Retrait" />
                    <TextView android:id="@+id/typeFilterCredit" style="@style/SmsFilterChip" android:text="Crédit" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/transactionCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="4dp"
                android:text="0 transaction"
                android:textColor="@color/sms_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_permission_notice"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Capture SMS inactive : l’autorisation de réception des SMS n’est pas accordée. Appuyez ici pour la demander."
                android:textColor="@color/sms_permission_text"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/backgroundExecutionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_permission_notice"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Exécution en arrière-plan limitée. Appuyez ici pour autoriser le démarrage automatique et la capture lorsque l’application est fermée."
                android:textColor="@color/sms_permission_text"
                android:textSize="14sp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:layout_width="@dimen/sms_table_width"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/smsTableHeader"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/sms_table_header"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView style="@style/SmsTableHeader.Number" android:text="#" />
                        <TextView style="@style/SmsTableHeader.DateTime" android:text="Date et heure" />
                        <TextView style="@style/SmsTableHeader.Type" android:text="Type" />
                        <TextView style="@style/SmsTableHeader.Sender" android:text="Numéro" />
                        <TextView style="@style/SmsTableHeader.Name" android:text="Nom" />
                        <TextView style="@style/SmsTableHeader.Money" android:text="Montant" />
                        <TextView style="@style/SmsTableHeader.Reference" android:text="Réf" />
                        <TextView style="@style/SmsTableHeader.Money" android:text="Bonus" />
                        <TextView style="@style/SmsTableHeader.Money" android:text="Frais" />
                        <TextView style="@style/SmsTableHeader.Money" android:text="Solde" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="Aucun message enregistré"
                        android:textColor="@color/sms_text_secondary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/loadingIndicator"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:contentDescription="Chargement des messages"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/transactionsList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp"
                        android:scrollbars="vertical" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/clientSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/clientListContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp">

                <EditText
                    android:id="@+id/clientSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_client_search"
                    android:drawableStart="@drawable/ic_search_24"
                    android:drawablePadding="10dp"
                    android:hint="Rechercher un numéro"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/sms_text_primary"
                    android:textColorHint="@color/sms_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/clientFilterAll" style="@style/SmsFilterChip"
                        android:text="Tous" />
                    <TextView android:id="@+id/clientFilterNew" style="@style/SmsFilterChip"
                        android:text="Nouveau" />
                    <TextView android:id="@+id/clientFilterExisting" style="@style/SmsFilterChip"
                        android:text="Ancien" />
                </LinearLayout>

                <TextView android:id="@+id/clientEmptyText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:gravity="center"
                    android:padding="24dp" android:text="Aucun client"
                    android:textColor="@color/sms_text_secondary" android:textSize="15sp"
                    android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/clientList"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clientDetailContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:background="@color/sms_surface" android:gravity="center_vertical"
                    android:orientation="horizontal" android:paddingEnd="16dp">
                    <TextView android:id="@+id/clientBackButton" android:layout_width="56dp"
                        android:layout_height="match_parent" android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true" android:focusable="true" android:gravity="center"
                        android:text="‹" android:textColor="@color/sms_text_primary" android:textSize="36sp"
                        android:contentDescription="Retour à la liste des clients" />
                    <TextView android:id="@+id/clientDetailTitle" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:ellipsize="end" android:maxLines="1"
                        android:textColor="@color/sms_text_primary" android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/client_table_width"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@color/sms_table_header"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView style="@style/SmsTableHeader.Number" android:text="#" />
                            <TextView style="@style/SmsTableHeader.DateTime" android:text="Date et heure" />
                            <TextView style="@style/SmsTableHeader.Type" android:text="Type" />
                            <TextView style="@style/SmsTableHeader.Money" android:text="Montant" />
                            <TextView style="@style/SmsTableHeader.Reference" android:text="Réf" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/clientMessageList"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:clipToPadding="false"
                            android:paddingBottom="8dp"
                            android:scrollbars="vertical" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </FrameLayout>

        <ScrollView
            android:id="@+id/homeSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Services"
                    android:textColor="@color/sms_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"
                    android:text="Sélectionnez une opération"
                    android:textColor="@color/sms_text_secondary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/cardDeposit"
                    style="@style/CommercialServiceCard"
                    android:contentDescription="Dépôt, Effectuer un dépôt">
                    <ImageView style="@style/CommercialServiceIcon" android:src="@drawable/ic_account_balance_wallet_24" />
                    <LinearLayout style="@style/CommercialServiceTextContainer">
                        <TextView style="@style/CommercialServiceTitle" android:text="Dépôt" />
                        <TextView style="@style/CommercialServiceSubtitle" android:text="Effectuer un dépôt" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardOffer"
                    style="@style/CommercialServiceCard"
                    android:contentDescription="Offre, Acheter une offre">
                    <ImageView style="@style/CommercialServiceIcon" android:src="@drawable/ic_local_offer_24" />
                    <LinearLayout style="@style/CommercialServiceTextContainer">
                        <TextView style="@style/CommercialServiceTitle" android:text="Offre" />
                        <TextView style="@style/CommercialServiceSubtitle" android:text="Acheter une offre" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardCredit"
                    style="@style/CommercialServiceCard"
                    android:contentDescription="Crédit, Acheter du crédit">
                    <ImageView style="@style/CommercialServiceIcon" android:src="@drawable/ic_phone_android_24" />
                    <LinearLayout style="@style/CommercialServiceTextContainer">
                        <TextView style="@style/CommercialServiceTitle" android:text="Crédit" />
                        <TextView style="@style/CommercialServiceSubtitle" android:text="Acheter du crédit" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/historySection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingTop="2dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/historyEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_history_24"
                    android:tint="@color/sms_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Aucun historique de transaction"
                    android:textColor="@color/sms_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView
            android:id="@+id/statisticsSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Statistiques"
                    android:textColor="@color/sms_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statisticsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="Suivi des bonus"
                    android:textColor="@color/sms_text_secondary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/statisticsBonusTab" style="@style/StatisticsTab" android:layout_marginEnd="6dp" android:text="BONUS" />
                    <TextView android:id="@+id/statisticsUserTab" style="@style/StatisticsTab" android:layout_marginStart="6dp" android:text="UTILISATEUR" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/userStatisticsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:background="@drawable/bg_statistics_card"
                        android:elevation="1dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView style="@style/BonusPeriodLabel" android:text="AUJOURD'HUI" />
                        <TextView android:id="@+id/todayUsersValue" style="@style/UserPrimaryValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout style="@style/TransactionTypeCard" android:layout_marginEnd="4dp">
                            <TextView style="@style/BonusPeriodLabel" android:text="DÉPÔT" />
                            <TextView android:id="@+id/depositTransactionsValue" style="@style/UserSecondaryValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/TransactionTypeCard" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                            <TextView style="@style/BonusPeriodLabel" android:text="CRÉDIT" />
                            <TextView android:id="@+id/creditTransactionsValue" style="@style/UserSecondaryValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/TransactionTypeCard" android:layout_marginStart="4dp">
                            <TextView style="@style/BonusPeriodLabel" android:text="RETRAIT" />
                            <TextView android:id="@+id/withdrawalTransactionsValue" style="@style/UserSecondaryValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginEnd="6dp">
                            <TextView style="@style/BonusPeriodLabel" android:text="HIER" />
                            <TextView android:id="@+id/yesterdayUsersValue" style="@style/UserSecondaryValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginStart="6dp">
                            <TextView style="@style/BonusPeriodLabel" android:text="CETTE SEMAINE" />
                            <TextView android:id="@+id/weekUsersValue" style="@style/UserSecondaryValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginEnd="6dp">
                            <TextView android:id="@+id/userMonthLabel" style="@style/BonusPeriodLabel" android:text="CE MOIS" />
                            <TextView android:id="@+id/monthUsersValue" style="@style/UserSecondaryValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginStart="6dp">
                            <TextView android:id="@+id/userYearLabel" style="@style/BonusPeriodLabel" android:text="CETTE ANNÉE" />
                            <TextView android:id="@+id/yearUsersValue" style="@style/UserSecondaryValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_statistics_card"
                        android:elevation="1dp"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <TextView android:id="@+id/statisticsPreviousMonth" style="@style/StatisticsMonthButton" android:contentDescription="Mois utilisateur précédent" android:text="‹" />
                            <TextView android:id="@+id/statisticsMonthText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/sms_text_primary" android:textSize="17sp" android:textStyle="bold" />
                            <TextView android:id="@+id/statisticsNextMonth" style="@style/StatisticsMonthButton" android:contentDescription="Mois utilisateur suivant" android:text="›" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="232dp">
                            <com.example.testapp.StatisticsChartView
                                android:id="@+id/userChart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/emptyUserChartText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:padding="20dp"
                                android:text="Aucune donnée utilisateur pour ce mois"
                                android:textAlignment="center"
                                android:textColor="@color/sms_text_secondary"
                                android:textSize="15sp" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bonusStatisticsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:background="@drawable/bg_statistics_card"
                        android:elevation="1dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView style="@style/BonusPeriodLabel" android:text="AUJOURD'HUI" />
                        <TextView android:id="@+id/todayBonusValue" style="@style/BonusPrimaryValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginEnd="6dp">
                            <TextView style="@style/BonusPeriodLabel" android:text="HIER" />
                            <TextView android:id="@+id/yesterdayBonusValue" style="@style/BonusSecondaryValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginStart="6dp">
                            <TextView style="@style/BonusPeriodLabel" android:text="CETTE SEMAINE" />
                            <TextView android:id="@+id/weekBonusValue" style="@style/BonusSecondaryValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginEnd="6dp">
                            <TextView android:id="@+id/bonusMonthLabel" style="@style/BonusPeriodLabel" android:text="CE MOIS" />
                            <TextView android:id="@+id/monthBonusValue" style="@style/BonusSecondaryValue" />
                        </LinearLayout>
                        <LinearLayout style="@style/BonusSecondaryCard" android:layout_marginStart="6dp">
                            <TextView android:id="@+id/bonusYearLabel" style="@style/BonusPeriodLabel" android:text="CETTE ANNÉE" />
                            <TextView android:id="@+id/yearBonusValue" style="@style/BonusSecondaryValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_statistics_card"
                        android:elevation="1dp"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <TextView android:id="@+id/bonusPreviousMonth" style="@style/StatisticsMonthButton" android:contentDescription="Mois bonus précédent" android:text="‹" />
                            <TextView android:id="@+id/bonusMonthText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/sms_text_primary" android:textSize="17sp" android:textStyle="bold" />
                            <TextView android:id="@+id/bonusNextMonth" style="@style/StatisticsMonthButton" android:contentDescription="Mois bonus suivant" android:text="›" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="232dp">
                            <com.example.testapp.StatisticsChartView
                                android:id="@+id/bonusChart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/emptyBonusChartText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:padding="20dp"
                                android:text="Aucune donnée bonus pour ce mois"
                                android:textAlignment="center"
                                android:textColor="@color/sms_text_secondary"
                                android:textSize="15sp" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.example.testapp.NotchedBottomBarView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView android:id="@+id/bottomMessages" style="@style/SmsBottomNavigationItem.Active" android:drawableTop="@drawable/ic_sms_24" android:text="Messages" />
            <TextView android:id="@+id/bottomClient" style="@style/SmsBottomNavigationItem" android:drawableTop="@drawable/ic_person_24" android:text="Client" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1.2" />
            <TextView android:id="@+id/bottomHistory" style="@style/SmsBottomNavigationItem" android:drawableTop="@drawable/ic_history_24" android:text="Historique" />
            <TextView android:id="@+id/bottomStatistics" style="@style/SmsBottomNavigationItem" android:drawableTop="@drawable/ic_bar_chart_24" android:text="Statistiques" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_home_button_inactive"
            android:contentDescription="Afficher l’accueil"
            android:elevation="10dp"
            android:padding="20dp"
            android:src="@drawable/ic_home_24"
            android:tint="@color/sms_bottom_item" />

        <TextView
            android:id="@+id/homeLabel"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center"
            android:paddingBottom="7dp"
            android:text="Accueil"
            android:textColor="@color/sms_bottom_item"
            android:textSize="10sp" />
    </FrameLayout>
</LinearLayout>
