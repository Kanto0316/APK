<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true"
    android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="12dp"
    app:cardElevation="1dp" app:strokeColor="@color/sms_divider" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp">
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/notificationSelected" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_vertical"
            android:layout_marginEnd="10dp" android:visibility="gone" />
        <ImageView android:id="@+id/notificationTypeIcon" android:layout_width="32dp"
            android:layout_height="32dp" android:layout_marginEnd="14dp" android:padding="5dp"
            android:background="@drawable/bg_notification_icon" android:tint="@color/verification_warning" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/notificationType" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/sms_text_primary" android:textSize="16sp" />
                <TextView android:id="@+id/notificationNew" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/bg_notification_new"
                    android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp"
                    android:paddingBottom="3dp" android:text="@string/notifications_new"
                    android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/notificationClient" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/sms_text_body" android:textSize="14sp" />
            <TextView android:id="@+id/notificationDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/sms_text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/notificationAmounts" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/sms_text_primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/notificationExplanation" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textColor="@color/sms_text_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
