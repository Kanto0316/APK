<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/sms_surface" android:orientation="vertical"
    android:paddingStart="18dp" android:paddingTop="14dp" android:paddingEnd="18dp"
    android:paddingBottom="14dp">
    <TextView android:id="@+id/clientMessageDate" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        android:textColor="@color/sms_text_primary" android:textSize="16sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/clientMessageTime" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="@color/sms_text_secondary"
        android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/clientMessageBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textColor="@color/sms_text_body" android:textIsSelectable="true"
        android:textSize="15sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="14dp" android:background="@color/sms_divider" />
</LinearLayout>
