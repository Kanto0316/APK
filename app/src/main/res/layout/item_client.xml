<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="96dp"
    android:layout_marginBottom="14dp" android:background="@drawable/bg_service_card"
    android:clickable="true" android:focusable="true" android:elevation="1dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="18dp" android:paddingEnd="18dp">

    <ImageView style="@style/CommercialServiceIcon" android:src="@drawable/ic_person_24"
        android:tint="@color/sms_accent" />
    <LinearLayout style="@style/CommercialServiceTextContainer">
        <TextView android:id="@+id/clientName" style="@style/CommercialServiceTitle" />
        <TextView android:id="@+id/clientMessageCount" style="@style/CommercialServiceSubtitle" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textColor="@color/sms_text_secondary" android:textSize="32sp" />
</LinearLayout>
