<resources>
    <style name="TransactionOverlayLabel">
        <item name="android:layout_width">82dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sms_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TransactionOverlayValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/sms_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!--
        Keep the application theme Material-based: layouts such as
        item_bonus_notification.xml inflate MaterialCardView directly.
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/sms_accent</item>
        <item name="colorPrimaryVariant">@color/sms_accent</item>
        <item name="colorSecondary">@color/sms_accent</item>
        <item name="colorSurface">@color/sms_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSurface">@color/sms_text_primary</item>
        <item name="android:colorAccent">@color/sms_accent</item>
        <item name="android:navigationBarColor">@color/sms_bottom_bar</item>
        <item name="android:statusBarColor">@color/sms_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Material widgets on the security screens require a Material-based theme. -->
    <style name="SecurityTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/sms_accent</item>
        <item name="colorPrimaryVariant">@color/sms_accent</item>
        <item name="colorSecondary">@color/sms_accent</item>
        <item name="colorSurface">@color/sms_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSurface">@color/sms_text_primary</item>
        <item name="android:colorAccent">@color/sms_accent</item>
        <item name="android:textColorPrimary">@color/sms_text_primary</item>
        <item name="android:textColorSecondary">@color/sms_text_secondary</item>
        <item name="android:navigationBarColor">@color/sms_bottom_bar</item>
        <item name="android:statusBarColor">@color/sms_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SmsBottomNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/sms_bottom_item</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="SmsBottomNavigationItem.Active">
        <item name="android:textColor">@color/sms_bottom_item_active</item>
    </style>

    <style name="SmsTableHeader">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/sms_table_header_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SmsTableHeader.Number" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_number_width</item><item name="android:gravity">center</item>
    </style>
    <style name="SmsTableHeader.Sender" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_sender_width</item><item name="android:paddingStart">4dp</item><item name="android:paddingEnd">4dp</item>
    </style>
    <style name="SmsTableHeader.DateTime" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_datetime_width</item><item name="android:gravity">center</item>
    </style>
    <style name="SmsTableHeader.Type" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_type_width</item><item name="android:gravity">center</item>
    </style>
    <style name="SmsTableHeader.Name" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_name_width</item><item name="android:gravity">center</item>
    </style>
    <style name="SmsTableHeader.Money" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_money_width</item><item name="android:gravity">center</item>
    </style>
    <style name="SmsTableHeader.Reference" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_reference_width</item><item name="android:gravity">center</item>
    </style>
    <style name="SmsTableHeader.Status" parent="SmsTableHeader">
        <item name="android:layout_width">@dimen/sms_column_status_width</item><item name="android:gravity">center</item>
    </style>

    <style name="SmsFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_filter_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TransactionFilterDropdown">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_filter_dropdown</item>
        <item name="android:clickable">true</item>
        <item name="android:drawableEnd">@drawable/ic_expand_more_20</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/sms_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StatisticsTab">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_filter_chip</item><item name="android:clickable">true</item><item name="android:focusable">true</item>
        <item name="android:gravity">center</item><item name="android:maxLines">1</item><item name="android:textColor">@color/filter_chip_text</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="StatisticsMonthButton">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item><item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item><item name="android:gravity">center</item><item name="android:textColor">@color/sms_accent</item><item name="android:textSize">32sp</item>
    </style>

    <style name="BonusSecondaryCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">104dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_statistics_card</item>
        <item name="android:elevation">1dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="TransactionTypeCard" parent="BonusSecondaryCard">
        <item name="android:padding">12dp</item>
    </style>
    <style name="BonusPeriodLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeMaxTextSize">12sp</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="android:textColor">@color/sms_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TodayPeriodLabel" parent="BonusPeriodLabel">
        <item name="android:textColor">@color/sms_accent</item>
    </style>
    <style name="StatisticsSecondaryValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:text">0 Ar</item>
        <item name="android:textColor">@color/sms_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BonusSecondaryValue" parent="StatisticsSecondaryValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeMaxTextSize">22sp</item>
        <item name="autoSizeMinTextSize">18sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="autoSizeTextType">uniform</item>
    </style>
    <style name="BonusPrimaryValue" parent="BonusSecondaryValue">
        <item name="autoSizeMaxTextSize">28sp</item>
        <item name="autoSizeMinTextSize">20sp</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="UserSecondaryValue" parent="StatisticsSecondaryValue">
        <item name="android:text">0</item>
    </style>
    <style name="UserPrimaryValue" parent="UserSecondaryValue">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="CommercialServiceCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">96dp</item>
        <item name="android:layout_marginBottom">14dp</item><item name="android:background">@drawable/bg_service_card</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
        <item name="android:elevation">1dp</item><item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item><item name="android:paddingStart">18dp</item><item name="android:paddingEnd">18dp</item>
    </style>
    <style name="CommercialServiceIcon">
        <item name="android:layout_width">52dp</item><item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_service_icon</item><item name="android:padding">14dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="CommercialServiceTextContainer">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item><item name="android:orientation">vertical</item>
    </style>
    <style name="CommercialServiceTitle">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/service_text_primary</item><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="CommercialServiceSubtitle">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/service_text_secondary</item><item name="android:textSize">14sp</item>
    </style>
</resources>
