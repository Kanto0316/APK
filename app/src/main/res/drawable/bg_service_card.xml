<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/sms_category_background" />
            <stroke android:width="1dp" android:color="@color/sms_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/sms_surface" />
            <stroke android:width="1dp" android:color="@color/sms_divider" />
        </shape>
    </item>
</selector>
