<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sms_accent" />
            <corners android:radius="18dp" />
            <padding android:left="13dp" android:top="0dp" android:right="13dp" android:bottom="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sms_filter_background" />
            <stroke android:width="1dp" android:color="@color/sms_filter_border" />
            <corners android:radius="18dp" />
            <padding android:left="13dp" android:top="0dp" android:right="13dp" android:bottom="0dp" />
        </shape>
    </item>
</selector>
